# 默认不需要模型密钥：使用确定性规划器即可跑通完整链路。
TESTPILOT_PLANNER=heuristic
TESTPILOT_ALLOWED_PORTS=8001
TESTPILOT_MAX_CASES=12
TESTPILOT_MAX_STEPS=10
TESTPILOT_TIMEOUT_SECONDS=3

# 可选：切换为兼容 Chat Completions 的 LLM 规划器。
# TESTPILOT_PLANNER=llm
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=replace_me
# LLM_MODEL=replace_me

